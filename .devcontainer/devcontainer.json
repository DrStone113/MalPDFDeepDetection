{
  "name": "MalPDFDeepDetection (Python 3.11)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ]
      }
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]' && python -m pip check"
}
